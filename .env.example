RPC_URL=https://rpc.monad.xyz
WALLET_ADDRESS=0xYourWalletAddressHere
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Optional: separate bot/chat for HF/APY emergency alerts, so the regular
# report chat can be muted without missing warnings. Leave blank to reuse
# TELEGRAM_TOKEN/TELEGRAM_CHAT_ID for alerts too.
TELEGRAM_EMERGENCY_TOKEN=
TELEGRAM_EMERGENCY_CHAT_ID=
REPORT_INTERVAL_MIN=2
HF_THRESHOLD=1.1
HF_CHECK_INTERVAL_MIN=1
REPORT_SILENT=true
APY_THRESHOLD=10
